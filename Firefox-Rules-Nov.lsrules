{
  "name": "Firefox-Rules-Nov",
  "description": "Standard app traffic from Firefox",
  "rules": [
  {
    "notes":"0.Default deny quic",
  "action" : "deny",
    "ports" : "443",
    "priority" : "high",
    "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
    "protocol" : "udp",
    "remote" : "any"
  },
  {
 "notes":"0.Default deny WWW/443",
    "action" : "deny",
    "ports" : "443",
    "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
    "protocol" : "tcp",
    "remote-domains" : 
  ["facebook.com",
  "facebook.net",
  "tiktokcdn.com",
"g.doubleclick.net",
      "static.doubleclick.net"
  ]
  },
      {
  	"notes":"Mozilla.com Domains 443",
        "action" : "allow",
        "ports" : "443",
        "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
        "remote-domains" : 
  	  ["mozilla.com",
  		"mozilla.net", 
  		"mozgcp.net",        
  	  	"classify-services.mozilla.com",
          	"firefox.settings.services.mozilla.com",  
  		"mozilla-ohttp.fastly-edge.com"
      ]
  },
      {
  	"notes":"Mozilla.org Domains 443",
        "action" : "allow",
        "ports" : "443",
        "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
         "remote-domains" : [   
  	"addons.mozilla.org",
        "aus5.mozilla.org",
        "download.mozilla.org",
        "telemetry.mozilla.org",
        "vpn.mozilla.org"
  	      ]
      },
      {
  	"notes":"Firefox Domains 443",
        "action" : "allow",
        "ports" : "443",
        "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
        "remote-domains" : 
  		[
          "accounts.firefox.com",
          "firefox-portal-detection.com",
          "firefox.com"
        ]
      },
      {
  	"notes":"Mozilla port 80",
        "action" : "allow",
        "ports" : "80",
        "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
        "protocol" : "tcp",
        "remote-domains" : "mozilla.com"
      },
    {
  "notes":"Github Domains 443",
       "action" : "allow",
       "ports" : "443",
       "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
       "protocol" : "tcp",
       "remote-domains" : [
         "avatars.githubusercontent.com",
  	"githubassets.com",
         "cafe.github.com",
         "central.github.com",
         "githubusercontent.com",
         "github.com",
         "github.io",
         "gitlab.com",
         "gitlab.io"
       ]
     },
    {
      "notes": "Atlassian",
      "action": "allow",
      "ports": "443",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
	  "protocol" : "tcp",
      "remote-domains": ["atl-paas.net","atlassian.com","atlassian.net",
      "atlassian.io","atlassian.com","atlassian.net","bitbucket.org","bytebucket.org","jira.com","valiantys.com"]
    },
    {
      "notes": "Terraform",
      "action": "allow",
      "ports": "443",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
	  "protocol" : "tcp",
      "remote-domains": ["terraform.net","terraform.com",""]
    },
    {
  	"notes":"Firewall WWW ",
      "action" : "allow",
      "ports" : "443",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol" : "tcp",
      "remote-domains" : [
        "paloaltonetworks.co.uk",
        "paloaltonetworks.com",
  	"fortinet.com",
  	"firewall.com",
      ]
    },
    {
  	"notes":"Domains Personal 2083",
      "action" : "allow",
      "ports" : "2083",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol" : "tcp",
      "remote-domains" : [
        "audaxum.me",
        "bluehost.com",
        "goethals.us",
        "nixihost.com"
      ]
    },
  {	
  	"notes":"Domains Personal 2096",
      "action" : "allow",
      "ports" : "2096",
      "process" : "\/Applications\/Firefox.app\/Contents\/MacOS\/firefox",
      "protocol" : "tcp",
      "remote-domains" : [
        "audaxum.me",
